<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TrayDrop.Core\TrayDrop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) 2026 Guru Gowda</Copyright>
    <RepositoryUrl>https://github.com/istartedcoding/TrayDrop</RepositoryUrl>
    <Description>Private, two-way file transfers on your local network.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrayDrop.Tests" />
  </ItemGroup>

</Project>